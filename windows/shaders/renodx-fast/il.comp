#version 460
// Passes (fast) Interleaved: one network pass a frame, the legacy passes in turn (slot = frame mod N, N 2..8, each with
// its own history, as legacy's). Kept per slot: its increment (answer - its input) in the proxy's space, moved along
// the motion vectors every frame. A still picture gives legacy N: every pass sees what it sees in legacy.
//   mode 0 (before the network): (flags & 2) Hist := what this slot would have written last frame - last frame's Base
//            + its increments up to this slot, before they move - the slot's network history, one frame old; then
//            Base := the proxy (this frame's encoded colour); every increment moved by this frame's vectors (src ->
//            dst; flags & 1, else copied); the proxy := Base + the increments of the slots before `slot`
//   mode 1 (after the network):  dst[slot] := the answer - the proxy (the slot's input); the answer := Base + every
//            increment; the proxy := Base (what the compose reads as the frame)
//   (flags & 268435456, the proxy kept: the frame stays in the proxy - mode 0 / 4 read it there and write the slot's input
//    into Base, which the network reads; mode 1 reads the input from Base and writes the frame into Base for the next
//    frame's BasePrev; mode 3 is not run)
#extension GL_EXT_samplerless_texture_functions : require
#extension GL_GOOGLE_include_directive : require
#include "../rdna4/include/nr_style_grade.glsl"
layout(local_size_x = 16, local_size_y = 16) in;
// The step as a specialization constant: each step its own pipeline, compiled for its own path only (one pipeline for
// all of them takes the registers of the heaviest - the fill's - and every step runs at its occupancy). Unspecialised:
// the push block's mode.
layout(constant_id = 0) const uint kStep = 0xFFFFu;
#define STEP (kStep != 0xFFFFu ? kStep : pc.mode)
layout(set = 0, binding = 0, rgba16f) uniform image2D Proxy;
layout(set = 0, binding = 1, rgba16f) uniform image2D Answer;
layout(set = 0, binding = 2, rgba16f) uniform image2D Base;
layout(set = 0, binding = 3) uniform texture2D Motion;
layout(set = 0, binding = 4) uniform texture2D S0;
layout(set = 0, binding = 5) uniform texture2D S1;
layout(set = 0, binding = 6) uniform texture2D S2;
layout(set = 0, binding = 7) uniform texture2D S3;
layout(set = 0, binding = 8) uniform texture2D S4;
layout(set = 0, binding = 9) uniform texture2D S5;
layout(set = 0, binding = 10) uniform texture2D S6;
layout(set = 0, binding = 11) uniform texture2D S7;
layout(set = 0, binding = 12, rgba16f) uniform image2D D0;
layout(set = 0, binding = 13, rgba16f) uniform image2D D1;
layout(set = 0, binding = 14, rgba16f) uniform image2D D2;
layout(set = 0, binding = 15, rgba16f) uniform image2D D3;
layout(set = 0, binding = 16, rgba16f) uniform image2D D4;
layout(set = 0, binding = 17, rgba16f) uniform image2D D5;
layout(set = 0, binding = 18, rgba16f) uniform image2D D6;
layout(set = 0, binding = 19, rgba16f) uniform image2D D7;
layout(set = 0, binding = 20, rgba16f) uniform writeonly image2D Hist;
// last frame's Base (Base is a pair: this frame's is written while last frame's is read)
layout(set = 0, binding = 21) uniform texture2D BasePrev;
// how far the moved increments are to be trusted at this pixel (mode 0 -> mode 1)
layout(set = 0, binding = 22, r16f) uniform image2D Trust;
// (NR_IL_DEBUG=2: each test's own answer - Trust, vectors, box, depth; 1 x 1 unless that view is on)
layout(set = 0, binding = 43, rgba16f) uniform image2D TrustDbg;
// the fill's pyramid (il_pp.comp, flags & 64): levels 1..6, the slots side by side
layout(set = 0, binding = 23) uniform texture2D L1;
layout(set = 0, binding = 24) uniform texture2D L2;
layout(set = 0, binding = 25) uniform texture2D L3;
layout(set = 0, binding = 26) uniform texture2D L4;
layout(set = 0, binding = 27) uniform texture2D L5;
layout(set = 0, binding = 28) uniform texture2D L6;
// the game's depth (flags & 256 / 512, research NR_IL_DEPTH): its region (dbase, dgrid) in DepthIn; this frame's and last
// frame's nearness at this size (mode 5 writes DepthCur; nearness = depth, or 1 - depth when it is not inverted)
layout(set = 0, binding = 29) uniform texture2D DepthIn;
layout(set = 0, binding = 30, r32f) uniform image2D DepthCur;
layout(set = 0, binding = 31) uniform texture2D DepthPrev;
// last frame's vectors at this size, in pixels (il_mv.comp's ring; flags & 8388608, NR_IL_VPREV)
layout(set = 0, binding = 36) uniform texture2D MvPrev;
// the depth pyramid (il_pp.comp, flags & 67108864, research NR_IL_DFILL): levels 1..6, mean nearness x weight, mean weight
layout(set = 0, binding = 37) uniform texture2D DP1;
layout(set = 0, binding = 38) uniform texture2D DP2;
layout(set = 0, binding = 39) uniform texture2D DP3;
layout(set = 0, binding = 40) uniform texture2D DP4;
layout(set = 0, binding = 41) uniform texture2D DP5;
layout(set = 0, binding = 42) uniform texture2D DP6;
// flags & 2048: the slots' networks ran plain (Standard, Intensity 1) and their increments are the network's own; each
// pass's Intensity and Style grade are applied here, pass after pass, as the network's post block does on its answer:
// styles = 2 bits a pass, inten = the Intensity, for passes 1..3 and 4 and later (the session's pass_controls)
layout(push_constant) uniform Push { uvec2 size, mbase, mgrid; vec2 mscale; uint mode, slot, n, flags; float k0, k1; uvec2 dbase, dgrid;
                                     uint styles, pad0; vec4 inten; } pc;
// pass k's answer from its input `base` and its network's own output `rgb` (fswin_t.comp's compose + grade)
vec3 post(uint k, vec3 base, vec3 rgb) {
    if ((pc.flags & 2048u) == 0u) return rgb;
    const uint kk = min(k, 3u), st = (pc.styles >> (2u * kk)) & 3u;
    const float I = pc.inten[kk];
    rgb = clamp(fma(vec3(min(I, 1.0)), rgb - base, base), vec3(0.0), vec3(1.0));
    if (I > 1.0) {
        const float fl = 1.0 / 512.0, guard = 2.0;
        const vec3 luma_w = vec3(0.2126, 0.7152, 0.0722);
        const float ratio = (dot(rgb, luma_w) + fl) / (dot(base, luma_w) + fl);
        const float amp = clamp(pow(max(ratio, 1e-6), I), 1.0 / guard, guard);
        rgb = clamp(rgb * (amp / max(ratio, 1e-6)), vec3(0.0), vec3(1.0));
    }
    if (st != 0u) rgb = nr_style_grade(st, base, rgb, I);
    return rgb;
}
float near_at(uvec2 mt) {   // the game's nearness at motion texel mt (its place in the depth's region)
    const uvec2 t = pc.dbase + min((mt - pc.mbase) * pc.dgrid / pc.mgrid, pc.dgrid - 1u);
    const float d = texelFetch(DepthIn, ivec2(t), 0).r;
    return (pc.flags & 1024u) != 0u ? d : 1.0 - d;
}
vec4 src(uint i, ivec2 c) {
    switch (i) {
        case 0u: return texelFetch(S0, c, 0); case 1u: return texelFetch(S1, c, 0);
        case 2u: return texelFetch(S2, c, 0); case 3u: return texelFetch(S3, c, 0);
        case 4u: return texelFetch(S4, c, 0); case 5u: return texelFetch(S5, c, 0);
        case 6u: return texelFetch(S6, c, 0); default: return texelFetch(S7, c, 0);
    }
}
vec3 bil(uint i, vec2 p) {   // bilinear at p (texel centres at +0.5), edges clamped
    const vec2 f = p - 0.5, b0 = floor(f), w = f - b0;
    const ivec2 i0 = ivec2(b0), hi = ivec2(pc.size) - 1;
    const vec3 a = src(i, clamp(i0, ivec2(0), hi)).rgb, b = src(i, clamp(i0 + ivec2(1, 0), ivec2(0), hi)).rgb;
    const vec3 c = src(i, clamp(i0 + ivec2(0, 1), ivec2(0), hi)).rgb, d = src(i, clamp(i0 + ivec2(1, 1), ivec2(0), hi)).rgb;
    return mix(mix(a, b, w.x), mix(c, d, w.x), w.y);
}
vec3 prevb(vec2 p) {   // last frame's Base, bilinear at p, edges clamped
    const vec2 f = p - 0.5, b0 = floor(f), w = f - b0;
    const ivec2 i0 = ivec2(b0), hi = ivec2(pc.size) - 1;
    const vec3 a = texelFetch(BasePrev, clamp(i0, ivec2(0), hi), 0).rgb, b = texelFetch(BasePrev, clamp(i0 + ivec2(1, 0), ivec2(0), hi), 0).rgb;
    const vec3 c = texelFetch(BasePrev, clamp(i0 + ivec2(0, 1), ivec2(0), hi), 0).rgb, d = texelFetch(BasePrev, clamp(i0 + ivec2(1, 1), ivec2(0), hi), 0).rgb;
    return mix(mix(a, b, w.x), mix(c, d, w.x), w.y);
}
vec3 ld(uint i, ivec2 p) {
    switch (i) {
        case 0u: return imageLoad(D0, p).rgb; case 1u: return imageLoad(D1, p).rgb;
        case 2u: return imageLoad(D2, p).rgb; case 3u: return imageLoad(D3, p).rgb;
        case 4u: return imageLoad(D4, p).rgb; case 5u: return imageLoad(D5, p).rgb;
        case 6u: return imageLoad(D6, p).rgb; default: return imageLoad(D7, p).rgb;
    }
}
void st(uint i, ivec2 p, vec3 v) {
    const vec4 o = vec4(v, 0.0);
    switch (i) {
        case 0u: imageStore(D0, p, o); break; case 1u: imageStore(D1, p, o); break;
        case 2u: imageStore(D2, p, o); break; case 3u: imageStore(D3, p, o); break;
        case 4u: imageStore(D4, p, o); break; case 5u: imageStore(D5, p, o); break;
        case 6u: imageStore(D6, p, o); break; default: imageStore(D7, p, o); break;
    }
}
vec4 lv(uint l, ivec2 c) {
    switch (l) {
        case 1u: return texelFetch(L1, c, 0); case 2u: return texelFetch(L2, c, 0); case 3u: return texelFetch(L3, c, 0);
        case 4u: return texelFetch(L4, c, 0); case 5u: return texelFetch(L5, c, 0); default: return texelFetch(L6, c, 0);
    }
}
// slot i's usable increments around p: push-pull - from the coarsest level down, each level's usable part over the
// coarser estimate (premultiplied: rgb + (1 - a) x below), so a hole fades into its surroundings with no level seams
vec2 dlv(uint l, ivec2 c) {
    switch (l) {
        case 1u: return texelFetch(DP1, c, 0).rg; case 2u: return texelFetch(DP2, c, 0).rg; case 3u: return texelFetch(DP3, c, 0).rg;
        case 4u: return texelFetch(DP4, c, 0).rg; case 5u: return texelFetch(DP5, c, 0).rg; default: return texelFetch(DP6, c, 0).rg;
    }
}
// level l's four texels around full-size position p and their bilinear weights (t)
void lvgeo(uint l, vec2 p, out ivec2 c[4], out int wx, out vec2 t) {
    uvec2 w = pc.size;
    for (uint k = 0u; k < l; ++k) w = (w + 1u) / 2u;
    const vec2 f = p / float(1u << l) - 0.5, b0 = floor(f);
    t = f - b0;
    const ivec2 i0 = ivec2(b0), hi = ivec2(w) - 1;
    c[0] = clamp(i0, ivec2(0), hi); c[1] = clamp(i0 + ivec2(1, 0), ivec2(0), hi);
    c[2] = clamp(i0 + ivec2(0, 1), ivec2(0), hi); c[3] = clamp(i0 + ivec2(1, 1), ivec2(0), hi);
    wx = int(w.x);
}
// near >= 0 (flags & 67108864): the four texels weighted also by how close their usable pixels' mean nearness is to this
// pixel's (joint bilateral) - a hole the camera or a person uncovers is filled from what lies at its depth, not from the
// person beside it. The weights are the same for every slot: made once a level (wb, their sum in w).
vec4 lvw(uint l, vec2 p, float near) {
    ivec2 c[4]; int wx; vec2 t;
    lvgeo(l, p, c, wx, t);
    vec4 wb = vec4((1.0 - t.x) * (1.0 - t.y), t.x * (1.0 - t.y), (1.0 - t.x) * t.y, t.x * t.y);
    for (int k = 0; k < 4; ++k) {
        const vec2 dn = dlv(l, c[k]);
        const float nk = dn.y > 1e-6 ? dn.x / dn.y : -1.0;
        const float rel = nk < 0.0 ? 1.0 : abs(nk - near) / max(max(nk, near), 1e-7);
        wb[k] *= 1.0 - smoothstep(0.05, 0.2, rel);
    }
    return wb;
}
// level l of slot i at full-size position p: bilinear, or (bil) with the level's bilateral weights wb
vec4 lvb(uint l, uint i, vec2 p, bool bil, vec4 wb) {
    ivec2 c[4]; int wx; vec2 t;
    lvgeo(l, p, c, wx, t);
    const ivec2 off = ivec2(int(i) * wx, 0);
    const vec4 a = lv(l, c[0] + off), b = lv(l, c[1] + off), cc = lv(l, c[2] + off), d = lv(l, c[3] + off);
    if (!bil) return mix(mix(a, b, t.x), mix(cc, d, t.x), t.y);
    const float sw = wb.x + wb.y + wb.z + wb.w;
    return sw > 1e-4 ? (a * wb.x + b * wb.y + cc * wb.z + d * wb.w) / sw * min(sw * 4.0, 1.0) : vec4(0.0);
}
// slot i's usable increments around p, filled from the coarsest level down; wl[l - 1]: level l's bilateral weights
vec3 pull(uint i, vec2 p, bool bil, const vec4 wl[6]) {
    const vec4 top0 = lvb(6u, i, p, false, vec4(0.0)), topd = bil ? lvb(6u, i, p, true, wl[5]) : top0;
    const vec4 top = topd.a > 1e-4 ? topd : top0;   // (nothing at its depth even at the top: the plain mean)
    vec3 e = top.a > 1e-4 ? top.rgb / top.a : vec3(0.0);
    for (uint l = 5u; l >= 1u; --l) {
        const vec4 m = lvb(l, i, p, bil, wl[l - 1u]);
        e = m.rgb + (1.0 - m.a) * e;
    }
    return e;
}
// the motion field's change over the move d around motion texel c (its gradient from 2 texels either side, in pixels here)
vec2 grad_v(ivec2 c, vec2 d) {
    const ivec2 lo = ivec2(pc.mbase), hi = ivec2(pc.mbase + pc.mgrid) - 1;
    const vec2 step = 2.0 * vec2(pc.size) / vec2(pc.mgrid);
    const vec2 mx = (texelFetch(Motion, clamp(c + ivec2(2, 0), lo, hi), 0).xy - texelFetch(Motion, clamp(c - ivec2(2, 0), lo, hi), 0).xy) * pc.mscale / (2.0 * step.x);
    const vec2 my = (texelFetch(Motion, clamp(c + ivec2(0, 2), lo, hi), 0).xy - texelFetch(Motion, clamp(c - ivec2(0, 2), lo, hi), 0).xy) * pc.mscale / (2.0 * step.y);
    return mx * d.x + my * d.y;
}
vec2 mvprev(vec2 p) {   // last frame's vector, bilinear at p, edges clamped
    const vec2 f = p - 0.5, b0 = floor(f), w = f - b0;
    const ivec2 i0 = ivec2(b0), hi = ivec2(pc.size) - 1;
    const vec2 a = texelFetch(MvPrev, clamp(i0, ivec2(0), hi), 0).xy, b = texelFetch(MvPrev, clamp(i0 + ivec2(1, 0), ivec2(0), hi), 0).xy;
    const vec2 c = texelFetch(MvPrev, clamp(i0 + ivec2(0, 1), ivec2(0), hi), 0).xy, d = texelFetch(MvPrev, clamp(i0 + ivec2(1, 1), ivec2(0), hi), 0).xy;
