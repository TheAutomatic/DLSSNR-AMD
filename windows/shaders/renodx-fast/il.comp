            const ivec2 d = ip / 2;
            imageStore(L1Out, ivec2(uint(d.x) + i * dw, d.y), s * 0.25);
            if (i == 0u && depth) imageStore(DP1Out, d, vec4(dn * 0.25, 0.0, 0.0));
