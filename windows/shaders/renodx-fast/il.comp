// of the moved increments weighted by Trust, the slots side by side in L1Out; (flags & 1073741824) its nearness level in
// DP1Out - from the values as stored (read back after this invocation's own stores), summed in il_pp's order
layout(set = 0, binding = 44, rgba16f) uniform writeonly image2D L1Out;
layout(set = 0, binding = 45, rg32f) uniform writeonly image2D DP1Out;
shared vec4 s_pp[256];
shared vec2 s_dp[256];
void pyr1(uvec2 px, bool live) {
    const ivec2 ip = ivec2(px);
    const uvec2 l = gl_LocalInvocationID.xy;
    const uint li = gl_LocalInvocationIndex;
    const bool lead = live && (l.x & 1u) == 0u && (l.y & 1u) == 0u;
    const bool depth = (pc.flags & 1073741824u) != 0u;
    const uint dw = (pc.size.x + 1u) / 2u;
    const float w = live ? imageLoad(Trust, ip).r : 0.0;
    for (uint i = 0u; i < pc.n; ++i) {
        s_pp[li] = live ? vec4(ld(i, ip) * w, w) : vec4(0.0);
        if (i == 0u && depth) s_dp[li] = live ? vec2(imageLoad(DepthCur, ip).r * w, w) : vec2(0.0);
        barrier();
        if (lead) {
            vec4 s = vec4(0.0);
            vec2 dn = vec2(0.0);
            for (uint y = 0u; y < 2u; ++y)
                for (uint x = 0u; x < 2u; ++x) {
                    if (any(greaterThanEqual(px + uvec2(x, y), pc.size))) continue;
                    s += s_pp[li + y * 16u + x];
                    if (i == 0u && depth) dn += s_dp[li + y * 16u + x];
