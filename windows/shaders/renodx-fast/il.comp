        return;
    }
    if (STEP == 0u) {
        const bool keep = (pc.flags & 268435456u) != 0u;
        const vec4 b = keep ? imageLoad(Proxy, ip) : imageLoad(Base, ip);
        if ((pc.flags & 2u) != 0u) {
            vec3 h = texelFetch(BasePrev, ip, 0).rgb;
            // (flags & 2048: the slot's network's own output - its input as the passes before made it, plus its increment)
            for (uint i = 0u; i < pc.slot && i < pc.n; ++i) h = post(i, h, h + src(i, ip).rgb);
