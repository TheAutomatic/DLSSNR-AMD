    if (STEP == 5u) {   // this frame's nearness at this size
        const uvec2 mt = pc.mbase + min(uvec2((vec2(px) + 0.5) * vec2(pc.mgrid) / vec2(pc.size)), pc.mgrid - 1u);
        imageStore(DepthCur, ip, vec4(near_at(mt)));
        return;
    }
    if (STEP == 4u) {
        // the fill (flags & 64, after mode 0 and the pyramid): increments not used are replaced by their usable
        // neighbours' (the room around a hole, not what was in front of it); then the slot's input as in mode 0
        const float trust = imageLoad(Trust, ip).r;
        if (trust >= 1.0) return;   // (all used: mode 0's input and increments stand)
