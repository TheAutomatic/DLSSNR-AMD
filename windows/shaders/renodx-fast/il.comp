        barrier();
    }
}
void body(uvec2 px);
void main() {
    const uvec2 px = gl_GlobalInvocationID.xy;
    const bool live = all(lessThan(px, pc.size));
    if (STEP == 0u && (pc.flags & 536870912u) != 0u) {   // (every invocation of the group: the barriers)
        if (live) body(px);
        pyr1(px, live);
        return;
    }
    if (live) body(px);
}
void body(uvec2 px) {
