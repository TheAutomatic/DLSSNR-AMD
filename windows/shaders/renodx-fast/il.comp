            // Neither fits (the vectors are wrong here: object edges, hair, disocclusion): the moved increments belong
            // to what was here, not to this - not used (flags & 4); after the network this slot's own takes their place.
            if ((pc.flags & 4u) != 0u) trust = 1.0 - smoothstep(0.015, 0.05, min(em, es));
            // Disocclusion (flags & 8): what is now where this pixel's content was last frame moves differently from it
            // (a character the camera follows, the room sliding out from behind it): last frame that place showed the
            // other thing, so the increments moved from there belong to it - not used.
            if ((pc.flags & 8u) != 0u) {
                const vec2 v = q - (vec2(px) + 0.5), qc = clamp(q, vec2(0.0), vec2(pc.size) - 0.001);
                const uvec2 t2 = pc.mbase + min(uvec2(qc * vec2(pc.mgrid) / vec2(pc.size)), pc.mgrid - 1u);
                // (flags & 8388608, NR_IL_VPREV: the vector there LAST frame - how what was there moved then. This frame's
                // vector there belongs to what is there now: under a person crossing, the wall behind, so the person's own
                // increments were thrown away and the fill's wall / ground increments carried along with the person)
                // (flags & 16777216, NR_IL_VPREV=2: the better of the two - this frame's there for a shaking camera, last
                // frame's for what moves steadily across the picture; a disocclusion is the depth test's)
                const bool vprev = (pc.flags & 8388608u) != 0u, vboth = (pc.flags & 16777216u) != 0u;
                const vec2 vq = vprev ? mvprev(q) : texelFetch(Motion, ivec2(t2), 0).xy * pc.mscale;
                float dv = length(vq - v);
                if (vboth) dv = min(dv, length(mvprev(q) - v));
                const float lv = length(v);
                // (flags & 524288, research NR_IL_VLIN=1): a camera turn's flow is not uniform (a wide field of view: the
                // edges move faster than the centre) - over a move of 100+ pixels the vectors there differ by more than
                // the test allows on a still wall. The vector there is predicted from this pixel's by the field's local
                // gradient (2 motion texels either side); only what that does not explain - an edge, a disocclusion -
                // counts. (the correction kept under half the move: a gradient taken across an object's edge)
                if ((pc.flags & 524288u) != 0u) {
                    const ivec2 tc = ivec2(pc.mbase + min(uvec2((vec2(px) + 0.5) * vec2(pc.mgrid) / vec2(pc.size)), pc.mgrid - 1u));
                    const vec2 gp = grad_v(tc, v);
                    const float cmax = 0.5 * lv;
                    dv = min(dv, length(vq - v - clampl(gp, cmax)));
                    // (flags & 1048576, NR_IL_VLIN=2: the gradient there too, and the mean of both - a building's corner: the
                    // flow bends there, one side's gradient does not reach across)
                    if ((pc.flags & 1048576u) != 0u) {
                        const vec2 gq = grad_v(ivec2(t2), v);
                        dv = min(dv, min(length(vq - v - clampl(gq, cmax)), length(vq - v - clampl(0.5 * (gp + gq), cmax))));
                    }
                }
                // (where they stay in place - a HUD - they did not come from there: not this test's)
                t_v = mix(1.0 - smoothstep(0.5 + 0.05 * lv, 2.0 + 0.15 * lv, dv), 1.0, stay);
                trust = min(trust, t_v);
            }
        }
        // The content they were made on is not around here any more (flags & 128, FSR2's neighbourhood box turned into
        // a test): last frame's picture where they come from lies outside this frame's 3 x 3 range - a HUD marker
        // that moved off a still arm, what was in front of a disocclusion. Inside it: moving texture, grain, sub-pixel
        // edges - kept.
        if ((pc.flags & 129u) == 129u) {
            // (where they stay in place - a HUD - last frame's picture in place is where they come from)
            const vec3 pv = mix(pq, texelFetch(BasePrev, ip, 0).rgb, stay), o = max(pv - hi, lo - pv);
            t_b = 1.0 - smoothstep(pc.k0, pc.k1, max(o.r, max(o.g, o.b)));
            trust = min(trust, t_b);
        }
        // Disocclusion by depth (flags & 512, FSR2/3): last frame, where this pixel's content comes from, something nearer
        // stood (the nearest of the 2 x 2 there) - what comes out from behind it now; the increments there were its.
        if ((pc.flags & 512u) != 0u && (pc.flags & 1u) != 0u && inside) {
            const ivec2 b0 = ivec2(floor(q - 0.5)), hi = ivec2(pc.size) - 1;
            float np = 0.0;
            for (int y = 0; y <= 1; ++y)
                for (int x = 0; x <= 1; ++x) np = max(np, texelFetch(DepthPrev, clamp(b0 + ivec2(x, y), ivec2(0), hi), 0).r);
            const float nc = imageLoad(DepthCur, ip).r, r = (np - nc) / max(nc, 1e-7);
            t_d = mix(1.0 - smoothstep(0.05, 0.2, r), 1.0, stay);
            trust = min(trust, t_d);
        }
        // Content coming in from outside the picture (flags & 33554432, research NR_IL_EDGE): nothing was moved here (the
        // increments are 0) - marked not used, so the fill continues the neighbours' into the strip instead of leaving
        // it with this frame's slot alone (a bright band along the edge the camera turns or shakes towards)
        if ((pc.flags & 33554433u) == 33554433u && !inside) trust = 0.0;
        if ((pc.flags & 652u) != 0u) imageStore(Trust, ip, vec4(trust));
        if ((pc.flags & 2097152u) != 0u) imageStore(TrustDbg, ip, vec4(trust, t_v, t_b, t_d));
        vec3 z = b.rgb;
        for (uint i = 0u; i < pc.n; ++i) {
            // moved: bilinear at the previous position; off the picture: no increment (the pass starts over there)
            vec3 v = !inside ? vec3(0.0) : (pc.flags & 1u) != 0u ? bil(i, q) : src(i, ip).rgb;
            if (stay > 0.0) v = mix(v, src(i, ip).rgb, stay);
            st(i, ip, v);
            if (i < pc.slot) z = post(i, z, z + trust * v);
        }
        if (keep) imageStore(Base, ip, vec4(clamp(z, 0.0, 1.0), b.a));
        else imageStore(Proxy, ip, vec4(clamp(z, 0.0, 1.0), b.a));
    } else {
        const bool keep = (pc.flags & 268435456u) != 0u;
        const vec4 a = imageLoad(Answer, ip), zin = keep ? imageLoad(Base, ip) : imageLoad(Proxy, ip),
                   b = keep ? imageLoad(Proxy, ip) : imageLoad(Base, ip);
        const vec3 fresh = a.rgb - zin.rgb;
        // (flags & 65536: mode 0 wrote Trust this frame - mode 1 runs without the move flags; filled: used as they are)
        float trust = (pc.flags & 65536u) != 0u && (pc.flags & 64u) == 0u ? imageLoad(Trust, ip).r : 1.0;
        // The network as the judge (flags & 32): this slot's own increment, moved here like the others, against what the
        // network makes of this pixel now. Where they disagree, what was moved here no longer belongs here - the network
        // (which sees this frame and its history) has said so - and the other slots' moved increments are not used.
        if ((pc.flags & 32u) != 0u) {
            const vec3 old = ld(pc.slot, ip);
            const float dl = length(fresh - old), r = dl / (max(length(fresh), length(old)) + 0.004);
            trust = min(trust, 1.0 - smoothstep(pc.k0, pc.k1, r) * smoothstep(0.006, 0.02, dl));
        }
        st(pc.slot, ip, fresh);
        vec3 o = b.rgb;
        for (uint i = 0u; i < pc.n; ++i) {
            vec3 v = i == pc.slot ? fresh : ld(i, ip);
            // kept: the next frames start clean
            if (i != pc.slot && trust < 1.0) { v = mix(fresh, v, trust); st(i, ip, v); }
            o = post(i, o, o + v);
        }
        // (flags & 262144, research NR_IL_DEBUG=1: mode 0's trust shown - not used = red)
        // (with flags & 2097152, NR_IL_DEBUG=2: each test in its colour - vectors red, box green, depth blue; flags & 4194304,
        // NR_IL_DEBUG=3: the game's nearness as IL reads it, log scale, and last frame's at the moved place in red)
        if ((pc.flags & 4194304u) != 0u) {
            const float n = imageLoad(DepthCur, ip).r;
            o = vec3(clamp(1.0 + log2(max(n, 1e-6)) / 12.0, 0.0, 1.0));
        } else if ((pc.flags & 2097152u) != 0u) {
            const vec4 t = imageLoad(TrustDbg, ip);
            o = mix(o, vec3(1.0 - t.g, 1.0 - t.b, 1.0 - t.a), 0.7 * (1.0 - min(t.g, min(t.b, t.a))));
        } else if ((pc.flags & 262144u) != 0u) o = mix(o, vec3(1.0, 0.0, 0.0), 0.7 * (1.0 - imageLoad(Trust, ip).r));
        imageStore(Answer, ip, vec4(clamp(o, 0.0, 1.0), a.a));
        if (keep) imageStore(Base, ip, b);
        else imageStore(Proxy, ip, b);
    }
}
