# Downloaded by fetch_deps.sh
/toolchain/
/artifacts/
# Build output
/build/
__pycache__/
/linux/package/*.tar.gz
/windows/package/*.zip
/linux/package/DLSSNR-AMD-Vulkan-*/
/windows/package/DLSSNR-AMD-Vulkan-Windows-*/
dlssnr-amd.pipelinecache
# Never commit NVIDIA's files or anything made from them
*.dll
*.bin
# except the int4 tables (CC_SILVER_AARDWOLD_OPTIMIZED's int4 layers): per-matrix corrections and calibration means, no
# weight values
!/linux/data/CC_SILVER_AARDWOLD_OPTIMIZED-balanced/**/*.bin
!/linux/data/CC_SILVER_AARDWOLD_OPTIMIZED-ultra/**/*.bin
# ... and CC_SMALL_FP8_OPTIMIZED Ultra Performance's int4 tables (the same kinds)
!/linux/data/CC_SMALL_FP8_OPTIMIZED-ultra/**/*.bin
nvngx*
