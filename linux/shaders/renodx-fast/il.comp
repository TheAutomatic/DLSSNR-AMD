// level l of slot i at full-size position p: bilinear, or (bil) with the level's bilateral weights wb
vec4 lvb(uint l, uint i, vec2 p, bool bil, vec4 wb) {
    ivec2 c[4]; int wx; vec2 t;
    lvgeo(l, p, c, wx, t);
    const ivec2 off = ivec2(int(i) * wx, 0);
    const vec4 a = lv(l, c[0] + off), b = lv(l, c[1] + off), cc = lv(l, c[2] + off), d = lv(l, c[3] + off);
    if (!bil) return mix(mix(a, b, t.x), mix(cc, d, t.x), t.y);
    const float sw = wb.x + wb.y + wb.z + wb.w;
    return sw > 1e-4 ? (a * wb.x + b * wb.y + cc * wb.z + d * wb.w) / sw * min(sw * 4.0, 1.0) : vec4(0.0);
