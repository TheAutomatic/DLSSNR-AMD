        vec3 o = b.rgb;float display_age=kMature1;
        for (uint i = 0u; i < pc.n; ++i) {
            const vec4 value=i==pc.slot?vec4(fresh,0):ld4(i,ip);
            vec3 v=value.rgb;
            if(i==(pc.slot+1u)%pc.n)display_age=value.a<-.5?clamp(-value.a-1,0,kMature1):kMature1;
            // kept: the next frames start clean
            if (i != pc.slot && trust < 1.0) { v = mix(fresh, v, trust); st(i, ip, v); }
            o = post(i, o, o + v);
        }
#if STABLE_APPLY
        if((pc.flags&16u)!=0u)o+=stable_at(vec2(px)+.5);
#endif
        // (flags & 262144, research NR_IL_DEBUG=1: mode 0's trust shown - not used = red)
        // (with flags & 2097152, NR_IL_DEBUG=2: each test in its colour - vectors red, box green, depth blue; flags & 4194304,
        // NR_IL_DEBUG=3: the game's nearness as IL reads it, log scale, and last frame's at the moved place in red)
        if ((pc.flags & 4194304u) != 0u) {
            const float n = imageLoad(DepthCur, ip).r;
            o = vec3(clamp(1.0 + log2(max(n, 1e-6)) / 12.0, 0.0, 1.0));
        } else if ((pc.flags & 2097152u) != 0u) {
            const vec4 t = imageLoad(TrustDbg, ip);
            o = mix(o, vec3(1.0 - t.g, 1.0 - t.b, 1.0 - t.a), 0.7 * (1.0 - min(t.g, min(t.b, t.a))));
        } else if ((pc.flags & 262144u) != 0u) o = mix(o, vec3(1.0, 0.0, 0.0), 0.7 * (1.0 - imageLoad(Trust, ip).r));
        st_meta(pc.slot,ip,fresh,history_lead);
        imageStore(Answer, ip, vec4(clamp(o, 0.0, 1.0), a.a));
        if (keep) imageStore(Base, ip, b);
        else imageStore(Proxy, ip, b);
    }
}
