// styles = 2 bits a pass, inten = the Intensity, for passes 1..3 and 4 and later (the session's pass_controls)
layout(push_constant) uniform Push { uvec2 size, mbase, mgrid; vec2 mscale; uint mode, slot, n, flags; float k0, k1; uvec2 dbase, dgrid;
                                     uint styles, pad0; vec4 inten; } pc;
// pass k's answer from its input `base` and its network's own output `rgb` (fswin_t.comp's compose + grade)
vec3 post(uint k, vec3 base, vec3 rgb) {
    if ((pc.flags & 2048u) == 0u) return rgb;
    const uint kk = min(k, 3u), st = (pc.styles >> (2u * kk)) & 3u;
    const float I = pc.inten[kk];
    rgb = clamp(fma(vec3(min(I, 1.0)), rgb - base, base), vec3(0.0), vec3(1.0));
    if (I > 1.0) {
        const float fl = 1.0 / 512.0, guard = 2.0;
        const vec3 luma_w = vec3(0.2126, 0.7152, 0.0722);
        const float ratio = (dot(rgb, luma_w) + fl) / (dot(base, luma_w) + fl);
        const float amp = clamp(pow(max(ratio, 1e-6), I), 1.0 / guard, guard);
        rgb = clamp(rgb * (amp / max(ratio, 1e-6)), vec3(0.0), vec3(1.0));
    }
