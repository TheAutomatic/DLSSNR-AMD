layout(binding=20,r16f) uniform writeonly image2D MatchOut0;
layout(binding=22) uniform sampler2D Match0;
layout(binding=24) uniform sampler2D ContextNow;   // context.comp's classes of this frame's depth / the anchors' depths
layout(binding=25) uniform sampler2D Context0;
layout(binding=26) uniform sampler2D Context1;
layout(binding=27,r8) uniform writeonly image2D PickOut;   // mode 6: near_tap() of each pixel (/ 255)
layout(binding=28) uniform sampler2D Pick;
layout(binding=29,r32f) uniform writeonly image2D DepthFullOut;   // mode 7: depth_at(Depth) at every pixel
layout(binding=30) uniform sampler2D DepthFull;
