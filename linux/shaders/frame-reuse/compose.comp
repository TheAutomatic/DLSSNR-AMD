layout(binding=10,rgba16f) uniform writeonly image2D OutEdit0;
layout(binding=11,rgba16f) uniform writeonly image2D OutEdit1;
layout(binding=12,rg32f) uniform writeonly image2D Composed;
layout(binding=13) uniform sampler2D Depth;
layout(binding=14) uniform sampler2D AnchorDepth0;
layout(binding=15) uniform sampler2D AnchorDepth1;
layout(binding=16,rgba16f) uniform writeonly image2D SideOut0;
