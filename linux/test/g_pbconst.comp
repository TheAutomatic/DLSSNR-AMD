#version 460
// Micro-test bisect variant: same interface as g_pbtest (2 SSBOs + 16-byte push), but writes a
// constant pattern without reading in_v or the push constant. If this comes back zero the
// dispatch/buffer plumbing is broken; if it matches, the input path (in_v or push) is.
layout(local_size_x = 64) in;
layout(std430, binding = 0) readonly buffer In { uint in_v[]; };
layout(std430, binding = 1) writeonly buffer Out { uint out_v[]; };
layout(push_constant) uniform Push { uint mul; uint add; uint n; uint seed; } p;
void main() {
    const uint i = gl_GlobalInvocationID.x;
    if (i >= p.n) return;
    out_v[i] = 0xdeadbe10u + i;
}
