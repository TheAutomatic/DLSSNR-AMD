#version 460
// The first ACO micro-test kernel: two storage buffers and a push constant, integer-exact
// arithmetic (out = in * mul + add + i). Captured on the drm-shim device, packed as a record
// and imported on the Windows driver (windows/test/aco_micro_test.cpp); the same dispatch is
// run through the driver's own compiler as the reference. The g_ prefix is what the binary
// importer's network path keys on.
layout(local_size_x = 64) in;
layout(std430, binding = 0) readonly buffer In { uint in_v[]; };
layout(std430, binding = 1) writeonly buffer Out { uint out_v[]; };
layout(push_constant) uniform Push { uint mul; uint add; uint n; uint seed; } p;
void main() {
    const uint i = gl_GlobalInvocationID.x;
    if (i >= p.n) return;
    const uint x = in_v[i] ^ (p.seed + i);
    out_v[i] = x * p.mul + p.add + i;
}
