#version 460
// Micro-test bisect variant 2: no guard at all — the dispatch size covers exactly `elements`,
// so every invocation writes unconditionally. Zero output here means the pipeline is not
// executing writes at all; the pattern means the guarded variants' inputs (push or array
// length) are what reads as zero.
layout(local_size_x = 64) in;
layout(std430, binding = 1) writeonly buffer Out { uint out_v[]; };
void main() {
    out_v[gl_GlobalInvocationID.x] = 0xdeadbe20u + gl_GlobalInvocationID.x;
}
