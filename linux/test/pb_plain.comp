#version 460
// The capture probe's plain shader: one storage buffer, ordinary ALU. Built into a pipeline
// and captured as a binary; never dispatched.
layout(local_size_x = 32) in;
layout(std430, binding = 0) buffer B { float x[]; };
void main() {
    const uint i = gl_GlobalInvocationID.x;
    if (i < x.length()) x[i] = x[i] * 2.0 + 1.0;
}
